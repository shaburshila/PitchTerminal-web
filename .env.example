# PitchTerminal-web — env vars
# Структура из docs/conventions.md §9. Никаких реальных секретов!
# На VPS: создать .env (chmod 600), на локалке — .env с dev-значениями.

# ─── Postgres ───────────────────────────────────────────────────────────────
# Docker compose использует POSTGRES_USER/PASSWORD/DB для init базы.
# DATABASE_URL — для backend (api + worker) подключения. На локалке user/pass = pt/pt;
# на проде ОБЯЗАТЕЛЬНО выставить непустые значения (см. docs/plans/infra.md §I0.6).
POSTGRES_USER=pt
POSTGRES_PASSWORD=pt
POSTGRES_DB=pt
DATABASE_URL=postgresql://pt:pt@localhost:5432/pt

# ─── JWT (HS256, 72h TTL) ───────────────────────────────────────────────────
# Сгенерировать: openssl rand -hex 32  (минимум 32 байта)
JWT_SECRET=

# ─── Base RPC ───────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.base.org
RPC_URL_FALLBACK=https://base.publicnode.com

# ─── Keeper (только газ — нельзя класть сюда основной кошелёк!) ─────────────
# Приватный ключ EOA, который воркер использует, чтобы вызывать
# `LimitOrderExecutor.execute(order, signature)` (см. worker/keeper.py, B2.3).
# Этот кошелёк НЕ держит средства пользователей — он только тратит газ. Любой
# адрес может вызвать execute() (permissionless), поэтому compromise ключа
# = потеря только остатка ETH на нём, ничего больше.
# Если переменная пустая — keeper-тик становится no-op (тихо, INFO-лог раз в
# минуту), весь остальной воркер продолжает работать.
KEEPER_PRIVATE_KEY=
# Порог газа (wei): когда баланс keeper-EOA падает ниже — алерт оператору
# (B0.14 hook'и пока не дописаны для keeper'а, но env-var зарезервирован).
KEEPER_GAS_THRESHOLD_WEI=10000000000000000

# ─── Telegram: operator alerts (MVP, outbound only) ─────────────────────────
OPERATOR_TG_BOT_TOKEN=
OPERATOR_TG_CHAT_ID=

# ─── Telegram: user alerts (фаза 3) ─────────────────────────────────────────
USER_TG_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Наши контракты (заполняется после деплоя) ──────────────────────────────
ACCESS_CONTRACT=
# LimitOrderExecutor (фаза 2). Placeholder до C2.6 deploy — пока контракт не
# задеплоен, EIP-712 verify в backend будет fail-closed (что и нужно для тестов).
EXECUTOR_CONTRACT=0x0000000000000000000000000000000000000000

# Shared secret для GET /api/v1/orders/armed (keeper-only). Длинный random
# string. На VPS заменить на `openssl rand -hex 32` ДО старта keeper'а (B2.3).
KEEPER_AUTH_TOKEN=changeme

# ─── Контракты pitchwc (Base mainnet) ───────────────────────────────────────
PLAYER_ROUTER=0x5F231AEA5AbD403aF0e8a32c1feF85a9a3ec5622
COUNTRY_ROUTER=0x61Cad011Db02D9924257F536bFD1ea615e42Bb9D
PLAYER_HOOK=0xd5252A67935fc6b913C4441ac0E5EBF3219fAAa8
COUNTRY_HOOK=0xCAE7EbFa18755d1f35eE8e0F3356f375ed5B2Aa8
PITCH_TOKEN=0xeae13ea73bec936664a51734c8c01ec7c3b0699c

# ─── Frontend bootstrap (отдаётся через /api/v1/config) ─────────────────────
# Получить project ID на cloud.walletconnect.com
WALLETCONNECT_PROJECT_ID=

# ─── SIWE ───────────────────────────────────────────────────────────────────
SIWE_DOMAIN=pitchterminal.app
SIWE_URI=https://pitchterminal.app

# ─── Caddy / TLS (prod compose) ─────────────────────────────────────────────
# Используются infra/docker-compose.prod.yml + Caddyfile.prod для site-блока
# и Let's Encrypt-обтайки. REQUIRED для прод-старта (compose валит fail-fast
# через ${VAR:?...}). На локалке (только docker-compose.yml + override) — не нужны.
DOMAIN=
ACME_EMAIL=

# ─── Параметры worker'а ─────────────────────────────────────────────────────
FRESHNESS_THRESHOLD_SEC=30
MAX_SLIPPAGE_BPS=1000
GAS_MULTIPLIER=1.5
CHUNK_BLOCKS_DEFAULT=5000
CHUNK_BLOCKS_FALLBACK=2000
REORG_LAG_BLOCKS=5
ORDER_COOLDOWN_SEC=60
RECEIPT_TIMEOUT_SEC=120
# Блок, с которого worker.access_event_loop начнёт сканировать события
# PriceChanged / ReferralSplitUpdated от PitchTerminalAccess. 0 = «использовать
# текущий head при первом запуске» (access_bootstrap зафиксирует ID).
# Заполняется после деплоя контракта (см. plans/contracts.md C0.5).
ACCESS_DEPLOY_BLOCK=0

# ─── Deploy-only (только на машине разработчика для forge script) ───────────
# Эти переменные backend/worker НЕ читают — они нужны только forge-скриптам
# `script/DeployAccess.s.sol` и аналогам.
#
# Кошелёк-получатель выручки (immutable в контракте после деплоя).
# REQUIRED — заполнить ДО `forge script ... --broadcast`. На mainnet обычно
# multisig / cold wallet, отдельный от OWNER (см. contracts/script/README.md).
TREASURY=
# Owner-кошелёк (Ownable2Step) — может менять цену, реферал-split, whitelist.
# REQUIRED. На mainnet: либо Ledger-EOA, либо Gnosis Safe multisig.
OWNER=
# Начальная цена доступа в wei (1e18 = 1 PITCH). REQUIRED, 0 < value ≤ 100e18.
ACCESS_PRICE=1000000000000000000
# Начальная двухсторонняя реферал-программа (см. docs/contracts.md §1).
# Сумма ≤ 5000 (MAX_TOTAL_REFERRAL_BPS), оба значения настраиваются после деплоя
# через setReferralSplit. Default = 25%/25%.
ACCESS_BUYER_DISCOUNT_BPS=2500
ACCESS_REFERRAL_BPS=2500
# Для forge verify на Basescan. REQUIRED для mainnet deploy с `--verify`.
BASESCAN_KEY=
# RPC для деплоя (отдельно от runtime RPC_URL — может отличаться, например
# Alchemy / приватный endpoint для деплоя). REQUIRED для mainnet deploy.
RPC_URL_BASE_MAINNET=

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Error tracking (Sentry) ────────────────────────────────────────────────
# Опционально. Если переменные пустые — Sentry не инициализируется (no-op),
# приложение работает как обычно. Заполни оба DSN, чтобы ловить uncaught
# ошибки на проде. Бесплатный tier sentry.io: 5k errors/мес.
#
# Регистрируешься на sentry.io → создаёшь два проекта:
#   - "pitchterminal-backend" (platform: python-flask)
#   - "pitchterminal-web"     (platform: browser-javascript)
# Копируешь DSN каждого проекта в соответствующую переменную.
#
# SENTRY_DSN ловит ошибки Flask API + worker (init в shared/sentry.py).
# VITE_SENTRY_DSN — build-time, читается Vite при `pnpm build`, поэтому
# меняется только при пересборке frontend-образа (caddy multi-stage).
# SENTRY_ENVIRONMENT — тег ("production" / "staging" / "dev"); default "production".
# Одно значение SENTRY_ENVIRONMENT используется и backend'ом (api/worker через
# env_file), и frontend bundle'ом — compose маппит его в build-arg
# VITE_SENTRY_ENVIRONMENT при сборке caddy multi-stage образа.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Off-site backups (Backblaze B2) ────────────────────────────────────────
# ВНИМАНИЕ: backup-кред'ы НЕ хранятся в этом .env (приложение их не читает).
# Они живут в ОТДЕЛЬНОМ файле на VPS: ~/.pt-backup.env (chmod 600), чтобы
# бэкап работал даже если app .env сломан и чтобы ротировать backup-key
# независимо. Ниже — справочно, какие переменные нужны для scripts/backup.sh.
# Полная инструкция: docs/runbook.md §14.
#
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=pt-backups
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
