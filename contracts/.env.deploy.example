# PitchTerminalAccess mainnet deploy — env template (C0.5)
#
# Usage:
#   cp .env.deploy.example .env.deploy
#   # fill the values below
#   set -a; source .env.deploy; set +a
#   # then run forge script (see contracts/script/README.md §Mainnet)
#
# NEVER commit the filled .env.deploy — it is covered by the root .gitignore
# `.env.*` glob.

# --- Constructor arguments --------------------------------------------------

# PITCH ERC20 on Base mainnet — canonical address, do not change.
PITCH_TOKEN=0xeae13ea73bec936664a51734c8c01ec7c3b0699c

# Immutable recipient of access payments.
# RECOMMENDED: multisig / cold wallet, distinct from OWNER and Deployer.
# After deploy this CANNOT be changed (even by owner key compromise).
TREASURY=0x0000000000000000000000000000000000000000

# Initial Ownable2Step owner — manages setPrice / setReferralSplit /
# grantAccess / revokeAccess. Can be a Gnosis Safe (recommended) or EOA.
# Distinct from TREASURY and Deployer.
OWNER=0x0000000000000000000000000000000000000000

# Initial access price in PITCH wei. Must satisfy 0 < price <= 100e18.
# 1 PITCH = 1000000000000000000 wei.
ACCESS_PRICE=1000000000000000000

# Referral split (optional — defaults mirror docs/contracts.md §1).
# Invariant: ACCESS_BUYER_DISCOUNT_BPS + ACCESS_REFERRAL_BPS <= 5000 (50%).
ACCESS_BUYER_DISCOUNT_BPS=2500
ACCESS_REFERRAL_BPS=2500

# --- RPC + verifier --------------------------------------------------------

# Base mainnet RPC. Public endpoint works for deploy; set a paid one only if
# you hit rate limits during --verify.
RPC_URL_BASE_MAINNET=https://mainnet.base.org

# Basescan API key for `forge verify`. Get one at https://basescan.org/myapikey
BASESCAN_KEY=

# --- Three-roles invariant -------------------------------------------------
#
# On mainnet, Deployer, OWNER, and TREASURY MUST be three distinct addresses:
#
#   - Deployer = the Ledger account that signs `--account ledger --sender 0x..`
#                Pays gas, never used again after deploy. May be a throwaway
#                hot wallet funded with ~$0.10 ETH on Base.
#   - OWNER    = long-term contract administrator. Use a Gnosis Safe.
#   - TREASURY = receives payments. Immutable. Cold storage or Safe.
#
# A successful Anvil-fork smoke (see contracts/script/README.md §Anvil fork)
# is the last check before signing the mainnet deploy with the Ledger.
